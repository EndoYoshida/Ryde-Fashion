# --- Database (Postgres) ---
# Local dev: run Postgres locally (or via Docker) and point this at it.
# Production (Render): use the "Internal Database URL" from your Render
# Postgres instance's dashboard — internal is faster and doesn't count
# against external bandwidth, since the API and DB live on Render together.
DATABASE_URL=postgres://user:password@localhost:5432/ryde

# --- Image storage (Cloudinary) ---
# From cloudinary.com -> Console (the free tier's 25GB is plenty to start).
# Used for product photos and checkout payment-proof screenshots — Render's
# own disk is ephemeral and wipes on every deploy, so images can't just be
# saved to a local folder like they could in local dev before this.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Admin dashboard login ---
# ADMIN_PASSWORD_HASH is generated with:
#   node scripts/hash-admin-password.js "your password"
# Never put a plaintext password here or anywhere in the codebase.
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD_HASH=

# Optional but strongly recommended: MFA for the admin login. Generate
# with:
#   node scripts/generate-totp-secret.js
# and follow the printed instructions. Leave blank to skip MFA (login
# stays password-only).
ADMIN_TOTP_SECRET=

# --- Firebase Authentication (customer sign-in) ---
# From the Firebase Console: Project settings -> Service accounts ->
# Generate new private key. That downloads a JSON file — copy the three
# fields below out of it. Keep the \n escapes in the private key literal
# (don't replace them with real line breaks).
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Support ticket email integration. EMAIL_USER is filled in, but
# EMAIL_APP_PASSWORD is intentionally left blank — that's a Gmail
# "App Password" (not your regular Gmail password), which you generate
# yourself. See the README for exact steps. Nothing email-related works
# until this is filled in.
EMAIL_USER=your-support-inbox@gmail.com
EMAIL_APP_PASSWORD=

# The API only accepts requests from this origin (CORS). Defaults to
# the local Vite dev server if not set — set this to your real frontend
# URL(s) in production. Accepts a single origin or several comma-separated
# (e.g. if you're keeping the onrender.com URL alive alongside a custom
# domain): https://rydefashion.com,https://www.rydefashion.com
# FRONTEND_ORIGIN=http://localhost:5173

# Public URL this server is reachable at (used for the logo in emails).
# APP_ORIGIN=http://localhost:4000

# --- PayMongo (online payments) ---
# From dashboard.paymongo.com -> Developers -> API Keys. Use the Test key
# while your Live account is still pending PayMongo's approval — sk_test_
# keys work immediately and let you fully build/test the flow now; swap
# in the sk_live_ key later and nothing else about this config needs to
# change (test vs. live mode is detected automatically from the key's
# own prefix).
PAYMONGO_SECRET_KEY=
# From Developers -> Webhooks after you register the endpoint below —
# without this, PayMongo payments will process fine on PayMongo's side
# but this app will never find out and orders will stay stuck "pending"
# forever. Register:
#   https://YOUR-API-DOMAIN/api/paymongo/webhook
# subscribed to at least the checkout_session.payment.paid event, then
# paste the signing secret it gives you here.
PAYMONGO_WEBHOOK_SECRET=
# Comma-separated list of payment method types to actually offer at
# checkout. IMPORTANT: only include a method here once it shows "Active"
# (not "Submitted"/pending review, not "Inactive") on your account's
# Payment Methods page in the PayMongo Dashboard — passing one that
# isn't active yet makes checkout fail outright for every customer who
# picks it. Defaults to qrph alone if unset. Common values: qrph, gcash,
# card, paymaya, grab_pay. Add more to this list the moment their
# dashboard status flips to Active — no code changes needed.
# PAYMONGO_PAYMENT_METHODS=qrph

# --- Google Sheets -> Products sync (optional) ---
# See server/sync/README-SHEETS-SYNC.md for full setup steps.
# Path to the service account JSON key file you downloaded from Google Cloud.
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./sync/service-account.json
# The Sheet ID from its URL: https://docs.google.com/spreadsheets/d/THIS_PART/edit
# SHEETS_SYNC_SHEET_ID=
# Tab name (and optional !A1:Z range) to read. Defaults to "Products".
# SHEETS_SYNC_RANGE=Products
# Set to "true" to have the server sync automatically on an interval.
# Leave unset/false if you'd rather trigger `npm run sync:sheet` from an
# OS cron job instead — don't enable both at once.
# SHEETS_SYNC_ENABLED=false
# SHEETS_SYNC_INTERVAL_MINUTES=15
# Removing a row from the sheet deletes that product (matched by sku).
# Set to "false" to keep sheet-removed products around instead of deleting them.
# SHEETS_SYNC_DELETE_MISSING=true
# After each checkout, the new stock count for any sold sheet-managed
# item is written back to its row in the sheet (needs the service account
# to have Editor, not just Viewer, access — see the README). Set to
# "false" to keep this strictly one-way/pull-only instead.
# SHEETS_SYNC_WRITE_STOCK=true

# --- Google Sheets: Inventory ERP sync (optional) ---
# The Sheet ID for the RYDE INVENTORY ERP sheet from its URL:
# SHEETS_SYNC_INVENTORY_ERP_SHEET_ID=
# Tab name (and optional !A1:Z range) to read/write. Defaults to "Inventory".
# SHEETS_SYNC_INVENTORY_ERP_RANGE=Inventory
# Set to "true" to enable writing stock updates to this ERP sheet.
# SHEETS_SYNC_WRITE_INVENTORY_ERP=true

# --- Google Sheets: Purchase Orders push (optional) ---
# See server/sync/README-PO-SYNC.md for full setup steps. Lives in the
# SAME spreadsheet as the Products sync above (SHEETS_SYNC_SHEET_ID) —
# every placed order is pushed into a "PO Register" tab (one row per
# order) and a "PO Items" tab (one row per line item), and status/
# payment-status changes update that order's PO Register row in place.
# This is one-way (site -> sheet only); nothing is ever read back.
# Tab names, if you want to rename them from the defaults:
# SHEETS_SYNC_PO_REGISTER_RANGE=PO Register
# SHEETS_SYNC_PO_ITEMS_RANGE=PO Items
# Set to "false" to turn this off entirely (Products sync above is
# unaffected either way).
# SHEETS_SYNC_PUSH_PO=true

# --- Automatic bestsellers (optional, on by default) ---
# See server/bestsellers/README-BESTSELLERS.md for full details.
# BESTSELLER_AUTO_ENABLED=true
# BESTSELLER_INTERVAL_HOURS=6
# BESTSELLER_COUNT=8
# BESTSELLER_WINDOW_DAYS=90
# BESTSELLER_MIN_QTY=3
