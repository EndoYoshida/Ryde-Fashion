# Where the backend API lives. Locally this defaults to
# http://localhost:4000 if unset — only needed for production.
# VITE_API_URL=https://api.rydefashion.com

# Firebase web app config (from Firebase Console -> Project settings ->
# General -> "Your apps"). These are not secret — they're safe to expose
# in frontend code, they just identify your Firebase project to the
# browser. Still set via env vars so you can point different environments
# (local/staging/production) at different Firebase projects without
# editing source.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=
